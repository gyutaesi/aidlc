{
  "manifest_version": 3,
  "name": "moaring",
  "version": "0.1.0",
  "description": "북마크를 빠르게 저장하고 공유하세요",
  "minimum_chrome_version": "102",
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "moaring"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/service-worker.ts",
    "type": "module"
  },
  "permissions": ["storage", "identity", "tabs", "topSites"],
  "host_permissions": [
    "http://*.elb.amazonaws.com/*",
    "http://*.amazonaws.com/*",
    "https://*.amazoncognito.com/*",
    "http://localhost:3000/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
