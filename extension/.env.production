# 실제 API 사용
VITE_USE_MOCK=false

# moaring API 서버 URL (ALB DNS — 배포 후 업데이트)
# cdk deploy 후: aws elbv2 describe-load-balancers --names moaring-alb --query 'LoadBalancers[0].DNSName' --output text
VITE_API_BASE_URL=http://REPLACE_WITH_ALB_DNS

# Cognito 설정 (cdk deploy 후 CloudFormation Output에서 확인)
# aws cloudformation describe-stacks --stack-name moaring-prod-auth --query 'Stacks[0].Outputs'
VITE_COGNITO_DOMAIN=moaring
VITE_COGNITO_CLIENT_ID=REPLACE_WITH_CLIENT_ID
VITE_COGNITO_REGION=us-east-1

# 웹앱 URL
VITE_WEBAPP_URL=http://REPLACE_WITH_ALB_DNS
