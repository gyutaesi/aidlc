# Mock API 사용 여부 (true: Mock, false: 실제 API)
VITE_USE_MOCK=true

# moaring API 서버 URL
VITE_API_BASE_URL=https://api.moaring.com

# Cognito 설정 (Unit 1 인프라 배포 후 입력)
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REGION=ap-northeast-2

# 웹앱 URL (이미 저장된 북마크 → 웹앱에서 보기 링크용)
VITE_WEBAPP_URL=https://moaring.com
